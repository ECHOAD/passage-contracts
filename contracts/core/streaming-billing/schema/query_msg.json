{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QueryMsg",
  "oneOf": [
    {
      "description": "Get contract configuration",
      "type": "object",
      "required": [
        "config"
      ],
      "properties": {
        "config": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Get user's streaming points balance",
      "type": "object",
      "required": [
        "user_balance"
      ],
      "properties": {
        "user_balance": {
          "type": "object",
          "required": [
            "user"
          ],
          "properties": {
            "user": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Get user's purchase history",
      "type": "object",
      "required": [
        "purchase_history"
      ],
      "properties": {
        "purchase_history": {
          "type": "object",
          "required": [
            "user"
          ],
          "properties": {
            "limit": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0.0
            },
            "start_after": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0.0
            },
            "user": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Get active streaming session",
      "type": "object",
      "required": [
        "session"
      ],
      "properties": {
        "session": {
          "type": "object",
          "required": [
            "session_id"
          ],
          "properties": {
            "session_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Get all active sessions for a user",
      "type": "object",
      "required": [
        "user_sessions"
      ],
      "properties": {
        "user_sessions": {
          "type": "object",
          "required": [
            "user"
          ],
          "properties": {
            "active_only": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "user": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Get world streaming configuration",
      "type": "object",
      "required": [
        "world_config"
      ],
      "properties": {
        "world_config": {
          "type": "object",
          "required": [
            "world_nft_id"
          ],
          "properties": {
            "world_nft_id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Get world revenue statistics",
      "type": "object",
      "required": [
        "world_stats"
      ],
      "properties": {
        "world_stats": {
          "type": "object",
          "required": [
            "world_nft_id"
          ],
          "properties": {
            "world_nft_id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Get accumulated revenue pending distribution",
      "type": "object",
      "required": [
        "pending_revenue"
      ],
      "properties": {
        "pending_revenue": {
          "type": "object",
          "required": [
            "world_nft_id"
          ],
          "properties": {
            "world_nft_id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Get the bounded local-economy configuration for a world.",
      "type": "object",
      "required": [
        "world_local_economy"
      ],
      "properties": {
        "world_local_economy": {
          "type": "object",
          "required": [
            "world_nft_id"
          ],
          "properties": {
            "world_nft_id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Preview how a world-local points flow settles back into PASG-aware accounting.",
      "type": "object",
      "required": [
        "preview_world_settlement"
      ],
      "properties": {
        "preview_world_settlement": {
          "type": "object",
          "required": [
            "world_nft_id"
          ],
          "properties": {
            "duration_seconds": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0.0
            },
            "points": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Uint128"
                },
                {
                  "type": "null"
                }
              ]
            },
            "user": {
              "type": [
                "string",
                "null"
              ]
            },
            "world_nft_id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Get conversion rate (points per PASG)",
      "type": "object",
      "required": [
        "conversion_rate"
      ],
      "properties": {
        "conversion_rate": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Get the canonical PASG utility surface for integrators",
      "type": "object",
      "required": [
        "pasg_utility"
      ],
      "properties": {
        "pasg_utility": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Get total platform statistics",
      "type": "object",
      "required": [
        "platform_stats"
      ],
      "properties": {
        "platform_stats": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ],
  "definitions": {
    "Uint128": {
      "description": "A thin wrapper around u128 that is using strings for JSON encoding/decoding, such that the full u128 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u128` to get the value out:\n\n``` # use cosmwasm_std::Uint128; let a = Uint128::from(123u128); assert_eq!(a.u128(), 123);\n\nlet b = Uint128::from(42u64); assert_eq!(b.u128(), 42);\n\nlet c = Uint128::from(70u32); assert_eq!(c.u128(), 70); ```",
      "type": "string"
    }
  }
}
