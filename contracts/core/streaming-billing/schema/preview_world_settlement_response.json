{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PreviewWorldSettlementResponse",
  "type": "object",
  "required": [
    "estimated_pasg_charge",
    "estimated_points_charge",
    "local_unit_kind",
    "refund_policy",
    "world_nft_id"
  ],
  "properties": {
    "available_points": {
      "anyOf": [
        {
          "$ref": "#/definitions/Uint128"
        },
        {
          "type": "null"
        }
      ]
    },
    "estimated_pasg_charge": {
      "$ref": "#/definitions/Uint128"
    },
    "estimated_points_charge": {
      "$ref": "#/definitions/Uint128"
    },
    "local_unit_kind": {
      "$ref": "#/definitions/WorldLocalUnitKind"
    },
    "maximum_chargeable_points": {
      "anyOf": [
        {
          "$ref": "#/definitions/Uint128"
        },
        {
          "type": "null"
        }
      ]
    },
    "refund_policy": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/RefundPolicyKind"
      }
    },
    "remaining_points_after_charge": {
      "anyOf": [
        {
          "$ref": "#/definitions/Uint128"
        },
        {
          "type": "null"
        }
      ]
    },
    "requested_duration_seconds": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0.0
    },
    "requested_points": {
      "anyOf": [
        {
          "$ref": "#/definitions/Uint128"
        },
        {
          "type": "null"
        }
      ]
    },
    "world_nft_id": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "RefundPolicyKind": {
      "type": "string",
      "enum": [
        "unused_points_withdrawable",
        "session_charge_capped_by_balance",
        "commerce_refunds_use_marketplace_and_auction_patterns"
      ]
    },
    "Uint128": {
      "description": "A thin wrapper around u128 that is using strings for JSON encoding/decoding, such that the full u128 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u128` to get the value out:\n\n``` # use cosmwasm_std::Uint128; let a = Uint128::from(123u128); assert_eq!(a.u128(), 123);\n\nlet b = Uint128::from(42u64); assert_eq!(b.u128(), 42);\n\nlet c = Uint128::from(70u32); assert_eq!(c.u128(), 70); ```",
      "type": "string"
    },
    "WorldLocalUnitKind": {
      "type": "string",
      "enum": [
        "points"
      ]
    }
  }
}
