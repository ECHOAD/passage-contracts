            "ecosystem_factory": {
              "type": [
                "string",
                "null"
              ]
            },
            "operators": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "paused": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "recovery_council": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
