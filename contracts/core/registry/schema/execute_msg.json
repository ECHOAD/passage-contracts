            "description": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "image_urls": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "name": {
              "type": "string"
            },
            "url": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Update an existing ecosystem",
      "type": "object",
      "required": [
        "update_ecosystem"
      ],
      "properties": {
        "update_ecosystem": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "admin": {
              "type": [
                "string",
                "null"
              ]
            },
            "animation_url": {
              "type": [
                "string",
                "null"
              ]
            },
            "collection_creation_policy": {
              "anyOf": [
                {
                  "$ref": "#/definitions/CollectionCreationPolicy"
                },
                {
                  "type": "null"
                }
              ]
            },
            "collection_factory": {
              "type": [
                "string",
                "null"
              ]
            },
            "description": {
              "type": [
                "string",
                "null"
              ]
            },
            "ecosystem_type": {
              "anyOf": [
                {
                  "$ref": "#/definitions/EcosystemType"
                },
                {
                  "type": "null"
                }
              ]
            },
            "id": {
              "type": "string"
            },
            "image_urls": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "url": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Approve a team member to register collections in an ecosystem",
      "type": "object",
      "required": [
        "approve_ecosystem_member"
