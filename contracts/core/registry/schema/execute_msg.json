          "properties": {
            "ecosystem_id": {
              "type": "string"
            },
            "member": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Revoke team member approval for an ecosystem",
      "type": "object",
      "required": [
        "revoke_ecosystem_member"
      ],
      "properties": {
        "revoke_ecosystem_member": {
          "type": "object",
          "required": [
            "ecosystem_id",
            "member"
          ],
          "properties": {
            "ecosystem_id": {
              "type": "string"
            },
            "member": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Submit request to be approved for collection creation in an ecosystem",
      "type": "object",
      "required": [
        "submit_collection_creation_request"
      ],
      "properties": {
        "submit_collection_creation_request": {
          "type": "object",
          "required": [
            "ecosystem_id"
          ],
          "properties": {
            "ecosystem_id": {
              "type": "string"
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Approve/reject a pending collection creation request",
      "type": "object",
      "required": [
        "resolve_collection_creation_request"
      ],
      "properties": {
        "resolve_collection_creation_request": {
          "type": "object",
          "required": [
            "approved",
            "creator",
            "ecosystem_id"
          ],
          "properties": {
            "approved": {
              "type": "boolean"
            },
            "creator": {
              "type": "string"
            },
            "ecosystem_id": {
              "type": "string"
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Register a new collection (pg721 contract)",
      "type": "object",
      "required": [
        "register_collection"
      ],
      "properties": {
        "register_collection": {
          "type": "object",
          "required": [
            "address",
            "ecosystem_id",
            "name"
          ],
          "properties": {
            "address": {
              "type": "string"
            },
            "ecosystem_id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Register collection from authorized ecosystem factory",
      "type": "object",
      "required": [
        "register_collection_from_factory"
      ],
      "properties": {
        "register_collection_from_factory": {
          "type": "object",
          "required": [
            "address",
            "creator",
            "ecosystem_id",
            "name"
          ],
          "properties": {
            "address": {
              "type": "string"
            },
            "creator": {
              "type": "string"
            },
            "ecosystem_id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Register an existing/already-deployed collection",
      "type": "object",
      "required": [
        "register_existing_collection"
      ],
      "properties": {
        "register_existing_collection": {
          "type": "object",
          "required": [
            "address",
            "creator",
            "ecosystem_id",
            "name"
          ],
          "properties": {
            "address": {
              "type": "string"
            },
            "creator": {
              "type": "string"
            },
            "ecosystem_id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Update collection metadata",
      "type": "object",
      "required": [
        "update_collection"
      ],
      "properties": {
        "update_collection": {
          "type": "object",
          "required": [
            "address"
          ],
          "properties": {
            "address": {
              "type": "string"
            },
            "marketplace": {
              "type": [
                "string",
                "null"
              ]
            },
            "minter": {
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "verified": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Transfer collection ownership",
      "type": "object",
      "required": [
        "transfer_collection_ownership"
      ],
      "properties": {
        "transfer_collection_ownership": {
          "type": "object",
          "required": [
            "address",
            "new_creator"
          ],
          "properties": {
            "address": {
              "type": "string"
            },
            "new_creator": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Authorize a minter for a collection",
      "type": "object",
      "required": [
        "authorize_minter"
      ],
      "properties": {
        "authorize_minter": {
          "type": "object",
          "required": [
            "collection_address",
            "minter_address"
          ],
          "properties": {
            "collection_address": {
              "type": "string"
            },
            "minter_address": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Revoke minter authorization",
      "type": "object",
      "required": [
        "revoke_minter"
      ],
      "properties": {
        "revoke_minter": {
          "type": "object",
          "required": [
            "collection_address",
            "minter_address"
          ],
          "properties": {
            "collection_address": {
              "type": "string"
            },
            "minter_address": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Update recovery configuration (admin only)",
      "type": "object",
      "required": [
        "update_recovery_config"
      ],
      "properties": {
        "update_recovery_config": {
          "type": "object",
          "properties": {
            "abandonment_inactivity_period_secs": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0.0
            },
            "contest_period_secs": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Open an ownership recovery case",
      "type": "object",
      "required": [
        "open_recovery_case"
      ],
      "properties": {
        "open_recovery_case": {
          "type": "object",
          "required": [
            "case_kind",
            "reason",
            "target"
          ],
          "properties": {
            "case_kind": {
              "$ref": "#/definitions/RecoveryCaseKind"
            },
            "evidence_url": {
              "type": [
                "string",
                "null"
              ]
            },
            "proposed_replacement": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": "string"
            },
            "target": {
              "$ref": "#/definitions/RecoveryTargetInput"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Contest a recovery case (target admin only)",
      "type": "object",
      "required": [
        "contest_recovery_case"
      ],
      "properties": {
        "contest_recovery_case": {
          "type": "object",
          "required": [
            "case_id"
          ],
          "properties": {
            "case_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Resolve a recovery case (recovery authority/admin only)",
      "type": "object",
      "required": [
        "resolve_recovery_case"
      ],
      "properties": {
        "resolve_recovery_case": {
          "type": "object",
          "required": [
            "approved",
            "case_id"
          ],
          "properties": {
            "approved": {
              "type": "boolean"
            },
            "case_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ],
  "definitions": {
    "CollectionCreationPolicy": {
      "type": "string",
      "enum": [
        "open",
        "permissioned",
        "approval_required"
      ]
    },
    "EcosystemType": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ]
    },
    "RecoveryCaseKind": {
      "description": "Ownership recovery case type.",
      "type": "string",
      "enum": [
        "lost_access",
        "abandonment"
      ]
    },
    "RecoveryTargetInput": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "ecosystem"
          ],
          "properties": {
            "ecosystem": {
              "type": "object",
              "required": [
                "ecosystem_id"
              ],
              "properties": {
                "ecosystem_id": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "collection"
          ],
          "properties": {
            "collection": {
              "type": "object",
              "required": [
                "address"
              ],
              "properties": {
                "address": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
