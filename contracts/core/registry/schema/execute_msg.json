            "mint_enabled": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "trade_enabled": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "additionalProperties": false
