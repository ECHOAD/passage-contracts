    {
      "description": "Set the ownership recovery policy for an ecosystem",
      "type": "object",
      "required": [
        "set_ecosystem_recovery_policy"
      ],
      "properties": {
        "set_ecosystem_recovery_policy": {
          "type": "object",
          "required": [
            "ecosystem_id"
          ],
          "properties": {
            "delegate": {
              "type": [
                "string",
                "null"
              ]
            },
            "designated_successor": {
              "type": [
                "string",
                "null"
              ]
            },
            "ecosystem_id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Set the ownership recovery policy for a collection",
      "type": "object",
      "required": [
        "set_collection_recovery_policy"
      ],
      "properties": {
        "set_collection_recovery_policy": {
          "type": "object",
          "required": [
            "address"
          ],
          "properties": {
            "address": {
              "type": "string"
            },
            "delegate": {
              "type": [
                "string",
                "null"
              ]
            },
            "designated_successor": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Register a new ecosystem from an authorized ecosystem factory",
      "type": "object",
      "required": [
        "register_ecosystem_from_factory"
      ],
      "properties": {
        "register_ecosystem_from_factory": {
          "type": "object",
          "required": [
            "collection_factory",
            "creator",
            "description",
            "id",
            "image_urls",
            "name"
          ],
          "properties": {
            "animation_url": {
              "type": [
                "string",
                "null"
              ]
            },
            "collection_factory": {
              "description": "Collection factory address (required - created by ecosystem-factory)",
              "type": "string"
            },
            "creator": {
              "type": "string"
