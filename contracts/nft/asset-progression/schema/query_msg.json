{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QueryMsg",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "config"
      ],
      "properties": {
        "config": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "snapshot"
      ],
      "properties": {
        "snapshot": {
          "type": "object",
          "required": [
            "collection",
            "token_id",
            "world"
          ],
          "properties": {
            "collection": {
              "type": "string"
            },
            "token_id": {
              "type": "string"
            },
            "world": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "snapshots_by_asset"
      ],
      "properties": {
        "snapshots_by_asset": {
          "type": "object",
          "required": [
            "collection",
            "token_id"
          ],
          "properties": {
            "collection": {
              "type": "string"
            },
            "limit": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0.0
            },
            "start_after_world": {
              "type": [
                "string",
                "null"
              ]
            },
            "token_id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "snapshots_by_world"
      ],
      "properties": {
        "snapshots_by_world": {
          "type": "object",
          "required": [
            "world"
          ],
          "properties": {
            "limit": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0.0
            },
            "start_after": {
              "anyOf": [
                {
                  "$ref": "#/definitions/SnapshotCursor"
                },
                {
                  "type": "null"
                }
              ]
            },
            "world": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ],
  "definitions": {
    "SnapshotCursor": {
      "type": "object",
      "required": [
        "collection",
        "token_id"
      ],
      "properties": {
        "collection": {
          "type": "string"
        },
        "token_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
